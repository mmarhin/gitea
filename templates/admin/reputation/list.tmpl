{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin reputation")}}
	<div class="admin-setting-content">
		<h4 class="ui top attached header">
			{{ctx.Locale.Tr "admin.reputation.labels"}} ({{ctx.Locale.Tr "admin.total" .Total}})
			<div class="ui right">
				<a class="ui primary tiny button" href="{{AppSubUrl}}/-/admin/reputation/new">{{ctx.Locale.Tr "admin.reputation.new_label"}}</a>
			</div>
		</h4>
		<div class="ui attached segment">
			<div class="ui secondary filter menu tw-items-center tw-mx-0">
				<form class="ui form ignore-dirty tw-flex-1">
					{{template "shared/search/combo" dict "Value" .Keyword}}
				</form>
			</div>
		</div>
		<div class="ui attached table segment">
			<table class="ui very basic table unstackable">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "name"}}</th>
						<th>{{ctx.Locale.Tr "admin.reputation.color"}}</th>
						<th>{{ctx.Locale.Tr "admin.reputation.description"}}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range .Labels}}
						<tr>
							<td>
								<a href="{{AppSubUrl}}/-/admin/reputation/{{.Name}}">{{.Name}}</a>
							</td>
							<td>{{.Color}}</td>
							<td class="gt-ellipsis tw-max-w-48">{{.Description}}</td>
							<td>
								<a class="link-action negative" href data-url="{{$.Link}}/delete?name={{.Name}}"
									data-modal-confirm-header="{{ctx.Locale.Tr "admin.reputation.delete"}} {{.Name}}"
									data-modal-confirm-content="{{ctx.Locale.Tr "admin.reputation.delete_desc"}}"
								>{{svg "octicon-trash"}}</a>
							</td>
						</tr>
					{{else}}
						<tr><td class="tw-text-center" colspan="6">{{ctx.Locale.Tr "no_results_found"}}</td></tr>
					{{end}}
				</tbody>
			</table>
		</div>

		{{template "base/paginate" .}}
	</div>

{{template "admin/layout_footer" .}}
